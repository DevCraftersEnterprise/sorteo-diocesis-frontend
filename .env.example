# URL base del backend NestJS (incluye el prefijo /api).
# Para desarrollo local con el backend corriendo en su puerto por defecto:
VITE_API_URL=http://localhost:3000/api

# Config del proyecto de Firebase (Firebase Console > Project settings >
# General > Your apps > Web app > SDK setup and configuration). Es la
# misma app de Firebase que ya usa el backend para verificar tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
